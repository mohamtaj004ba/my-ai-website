    "default_permissions": {
      "metadata": "read",
      "contents": "write",
      "pull_requests": "write",
      "issues": "write",
      "actions": "write"
    }
  },
  "missingOwnerInputs": ["Confirm App owner and available App name", "Confirm the required public HTTPS App homepage URL"],
