  "initialTokenRepositorySelection": "explicit-single-numeric-repository-id-required",
  "callerCoreDisabledOperations": ["repository-write", "branch-create", "reference-delete", "tag-create", "pull-request-create", "pull-request-merge", "issue-write", "workflow-dispatch", "workflow-rerun", "workflow-cancel", "workflow-file-write", "main-write", "production-access"],
  "prohibitedAppPermissions": ["administration", "secrets", "workflows"],
  "credentialsCreated": false,
  "accountCreated": false,
  "installationPerformed": false,
  "providerDocumentation": "https://docs.github.com/en/apps/sharing-github-apps/registering-a-github-app-from-a-manifest"
