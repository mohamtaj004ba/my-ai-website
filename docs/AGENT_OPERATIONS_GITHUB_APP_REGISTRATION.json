  "repositorySelection": "selected",
  "repositories": ["mohamtaj004ba/my-ai-website"],
  "providerManifestFields": {
    "name": "CallerCore Agent Operations",
    "description": "CallerCore repository-scoped engineering integration; operational permissions remain separately enforced by CallerCore.",
    "public": false,
    "hook_attributes": {"active": false},
    "default_events": [],
