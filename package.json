{
  "name": "my-ai-website",
  "version": "1.0.0",
  "description": "CallerCore - AI-powered call management website",
  "main": "index.html",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build": "npm test && echo \"CallerCore static build checks passed\"",
    "test": "node --test tests/*.test.js",
    "preflight": "npm test",
    "preflight:agentops": "node scripts/agent-operations-contract-preflight.cjs",
    "preflight:engineering": "node scripts/engineering-quality-preflight.cjs",
    "preflight:live": "node scripts/agent-operations-live-readiness.cjs",
    "qa:preview": "node scripts/preview-browser-qa.mjs",
    "verify:development": "node scripts/development-verification.cjs --run",
    "verify:plan": "node scripts/development-verification.cjs --plan",
    "checkpoint:development": "node scripts/development-checkpoint.cjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^1.1.1",
    "@vercel/functions": "3.9.11",
    "@vercel/speed-insights": "^1.0.12",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "pixelmatch": "7.1.0",
    "playwright": "1.55.0",
    "pngjs": "7.0.0"
  },
  "keywords": [
    "vercel",
    "analytics",
    "static-website"
  ],
  "author": "",
  "license": "MIT"
}
